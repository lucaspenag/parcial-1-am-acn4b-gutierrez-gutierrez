<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/alto_barra_navegacion"
    android:background="@color/superficie"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/nav_biblioteca"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:drawablePadding="@dimen/espacio_chico"
        android:gravity="center"
        android:paddingTop="@dimen/espacio_medio"
        android:text="@string/nav_biblioteca"
        android:textColor="@color/texto_secundario"
        android:textSize="@dimen/texto_navegacion"
        app:drawableTopCompat="@drawable/ic_biblioteca"
        app:drawableTint="@color/texto_secundario" />

    <TextView
        android:id="@+id/nav_diario"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:drawablePadding="@dimen/espacio_chico"
        android:gravity="center"
        android:paddingTop="@dimen/espacio_medio"
        android:text="@string/nav_diario"
        android:textColor="@color/texto_secundario"
        android:textSize="@dimen/texto_navegacion"
        app:drawableTopCompat="@drawable/ic_diario"
        app:drawableTint="@color/texto_secundario" />

    <TextView
        android:id="@+id/nav_estadisticas"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:drawablePadding="@dimen/espacio_chico"
        android:gravity="center"
        android:paddingTop="@dimen/espacio_medio"
        android:text="@string/nav_estadisticas"
        android:textColor="@color/texto_secundario"
        android:textSize="@dimen/texto_navegacion"
        app:drawableTopCompat="@drawable/ic_estadisticas"
        app:drawableTint="@color/texto_secundario" />
</LinearLayout>
