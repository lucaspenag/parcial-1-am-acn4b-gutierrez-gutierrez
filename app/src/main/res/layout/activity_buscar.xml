<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".BuscarActivity">

    <LinearLayout
        android:id="@+id/encabezado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/margen_pantalla"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_volver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/espacio_medio"
            android:paddingEnd="@dimen/espacio_grande"
            android:paddingBottom="@dimen/espacio_medio"
            android:text="@string/volver"
            android:textColor="@color/acento"
            android:textSize="@dimen/texto_cuerpo"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/titulo_buscar"
            android:textColor="@color/texto_primario"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/barra_busqueda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_medio"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/encabezado">

        <EditText
            android:id="@+id/et_busqueda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_buscar"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textColor="@color/texto_primario"
            android:textColorHint="@color/texto_tenue"
            android:textSize="@dimen/texto_cuerpo" />

        <Button
            android:id="@+id/btn_buscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_medio"
            android:backgroundTint="@color/primario"
            android:text="@string/buscar"
            android:textColor="@color/white"
            android:textSize="@dimen/texto_boton" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_enorme"
        android:indeterminateTint="@color/acento"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barra_busqueda" />

    <TextView
        android:id="@+id/tv_mensaje"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_enorme"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:gravity="center"
        android:text="@string/buscar_inicial"
        android:textColor="@color/texto_tenue"
        android:textSize="@dimen/texto_cuerpo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barra_busqueda" />

    <ScrollView
        android:id="@+id/scroll_resultados"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_medio"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:layout_marginBottom="@dimen/espacio_medio"
        app:layout_constraintBottom_toTopOf="@id/tv_fuente"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barra_busqueda">

        <LinearLayout
            android:id="@+id/contenedor_resultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/tv_fuente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/espacio_medio"
        android:text="@string/fuente_rawg"
        android:textColor="@color/texto_tenue"
        android:textSize="@dimen/texto_chico"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
