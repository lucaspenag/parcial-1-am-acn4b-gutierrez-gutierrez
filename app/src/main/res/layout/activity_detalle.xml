<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".DetalleActivity">

    <TextView
        android:id="@+id/tv_volver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_medio"
        android:paddingTop="@dimen/espacio_medio"
        android:paddingEnd="@dimen/espacio_grande"
        android:paddingBottom="@dimen/espacio_chico"
        android:text="@string/volver"
        android:textColor="@color/acento"
        android:textSize="@dimen/texto_cuerpo"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/encabezado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_medio"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_volver">

        <ImageView
            android:id="@+id/img_portada"
            android:layout_width="@dimen/portada_ancho"
            android:layout_height="@dimen/portada_alto"
            android:contentDescription="@string/desc_portada_juego"
            android:scaleType="centerCrop"
            android:src="@drawable/portada_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_grande"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_titulo_juego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cargando"
                android:textColor="@color/texto_primario"
                android:textSize="@dimen/texto_titulo"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_desarrollador_anio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_chico"
                android:text="@string/cargando"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_cuerpo" />

            <TextView
                android:id="@+id/tv_genero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_cuerpo" />

            <TextView
                android:id="@+id/tv_plataformas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/texto_cuerpo" />

            <TextView
                android:id="@+id/tv_puntaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_chico"
                android:textColor="@color/acento"
                android:textSize="@dimen/texto_cuerpo"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_chico"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/etiqueta_estado"
                    android:textColor="@color/texto_secundario"
                    android:textSize="@dimen/texto_cuerpo" />

                <TextView
                    android:id="@+id/tv_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_chico"
                    android:text="@string/estado_jugando"
                    android:textColor="@color/estado_jugando"
                    android:textSize="@dimen/texto_cuerpo"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_sinopsis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_grande"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:ellipsize="end"
        android:lineSpacingExtra="@dimen/interlineado"
        android:maxLines="@integer/lineas_sinopsis"
        android:text="@string/cargando"
        android:textColor="@color/texto_secundario"
        android:textSize="@dimen/texto_cuerpo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/encabezado" />

    <TextView
        android:id="@+id/tv_ver_mas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_chico"
        android:paddingBottom="@dimen/espacio_chico"
        android:text="@string/ver_mas"
        android:textColor="@color/acento"
        android:textSize="@dimen/texto_chico"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_sinopsis" />

    <LinearLayout
        android:id="@+id/botones_estado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_medio"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_ver_mas">

        <Button
            android:id="@+id/btn_jugando"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espacio_chico"
            android:layout_weight="1"
            android:backgroundTint="@color/superficie"
            android:maxLines="1"
            android:paddingStart="@dimen/padding_boton"
            android:paddingEnd="@dimen/padding_boton"
            android:text="@string/estado_jugando"
            android:textColor="@color/estado_jugando"
            android:textSize="@dimen/texto_boton" />

        <Button
            android:id="@+id/btn_completado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_chico"
            android:layout_marginEnd="@dimen/espacio_chico"
            android:layout_weight="1"
            android:backgroundTint="@color/superficie"
            android:maxLines="1"
            android:paddingStart="@dimen/padding_boton"
            android:paddingEnd="@dimen/padding_boton"
            android:text="@string/estado_completado"
            android:textColor="@color/estado_completado"
            android:textSize="@dimen/texto_boton" />

        <Button
            android:id="@+id/btn_pausado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_chico"
            android:layout_weight="1"
            android:backgroundTint="@color/superficie"
            android:maxLines="1"
            android:paddingStart="@dimen/padding_boton"
            android:paddingEnd="@dimen/padding_boton"
            android:text="@string/estado_pausado"
            android:textColor="@color/estado_pausado"
            android:textSize="@dimen/texto_boton" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_titulo_bitacora"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_grande"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/botones_estado">

        <TextView
            android:id="@+id/tv_titulo_bitacora"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/titulo_bitacora"
            android:textColor="@color/texto_primario"
            android:textSize="@dimen/texto_subtitulo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_ayuda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ayuda_borrar"
            android:textColor="@color/texto_tenue"
            android:textSize="@dimen/texto_chico" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_vacio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_grande"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:gravity="center"
        android:text="@string/bitacora_vacia"
        android:textColor="@color/texto_tenue"
        android:textSize="@dimen/texto_cuerpo"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fila_titulo_bitacora" />

    <ScrollView
        android:id="@+id/scroll_bitacora"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_medio"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:layout_marginBottom="@dimen/espacio_medio"
        app:layout_constraintBottom_toTopOf="@id/barra_entrada"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fila_titulo_bitacora">

        <LinearLayout
            android:id="@+id/contenedor_entradas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/barra_entrada"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:layout_marginBottom="@dimen/espacio_medio"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/et_entrada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_entrada"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="@integer/lineas_max_entrada"
            android:textColor="@color/texto_primario"
            android:textColorHint="@color/texto_tenue"
            android:textSize="@dimen/texto_cuerpo" />

        <Button
            android:id="@+id/btn_agregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_medio"
            android:backgroundTint="@color/primario"
            android:text="@string/agregar"
            android:textColor="@color/white"
            android:textSize="@dimen/texto_boton" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>